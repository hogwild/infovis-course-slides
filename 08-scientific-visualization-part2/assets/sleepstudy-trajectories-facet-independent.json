{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "config": {
    "background": "#ffffff",
    "view": {
      "stroke": "#d9dde5"
    },
    "axis": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelFontSize": 13,
      "titleFontSize": 14,
      "titleColor": "#17233c",
      "labelColor": "#445064",
      "gridColor": "#e8ebf0"
    },
    "header": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelFontSize": 12,
      "titleFontSize": 13,
      "labelColor": "#17233c"
    },
    "legend": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelFontSize": 12,
      "titleFontSize": 13
    }
  },
  "data": {
    "url": "sleepstudy.csv"
  },
  "columns": 6,
  "facet": {
    "field": "Subject",
    "type": "nominal",
    "title": null
  },
  "spec": {
    "width": 115,
    "height": 80,
    "mark": {
      "type": "line",
      "point": {
        "filled": true,
        "size": 16
      },
      "strokeWidth": 1.5,
      "color": "#3157a4"
    },
    "encoding": {
      "x": {
        "field": "Days",
        "type": "quantitative",
        "title": null,
        "scale": {
          "domain": [
            0,
            9
          ]
        },
        "axis": {
          "values": [
            0,
            3,
            6,
            9
          ],
          "labelFontSize": 9
        }
      },
      "y": {
        "field": "Reaction",
        "type": "quantitative",
        "title": null,
        "scale": {
          "zero": false
        },
        "axis": {
          "values": [
            200,
            300,
            400
          ],
          "labelFontSize": 9
        }
      }
    }
  },
  "resolve": {
    "scale": {
      "y": "independent"
    }
  }
}
